VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:5269
# O Mercado Livre só aceita redirect_uri previamente registrada no app, então em
# desenvolvimento apontamos para a URI publicada. Sem esta variável a URI é
# derivada do host atual (http://localhost:5173/redirects), que o ML recusa.
VITE_MERCADO_LIVRE_REDIRECT_URI=https://profitcore-frontend.netlify.app/redirects
